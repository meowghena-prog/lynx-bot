# --- اللعبة 1: حجر ورقة مقص (مع أزرار + نقاط) ---
class RPSView(discord.ui.View):
    def __init__(self, author_id: int):
        super().__init__(timeout=30)
        self.author_id = author_id

    async def play(self, interaction: discord.Interaction, user_choice: str):
        if interaction.user.id != self.author_id:
            await interaction.response.send_message(
                "هذه اللعبة لشخص آخر! اكتب `/rps` لتبدأ لعبتك.",
                ephemeral=True,
            )
            return

        choices = ["حجر", "ورقة", "مقص"]
        bot_choice = random.choice(choices)
        bonus_text = ""

        if user_choice == bot_choice:
            result = "تعادل! 🤝"
        elif (
            (user_choice == "حجر" and bot_choice == "مقص")
            or (user_choice == "ورقة" and bot_choice == "حجر")
            or (user_choice == "مقص" and bot_choice == "ورقة")
        ):
            new_total = add_points(interaction.user.id, 5)
            result = "أنت فزت! 🎉"
            bonus_text = f"\n⭐ ربحت **+5 نقاط** (رصيدك الآن: **{new_total}**)"
        else:
            result = "أنا فزت! 🤖"

        for item in self.children:
            item.disabled = True

        await interaction.response.edit_message(
            content=(
                f"اختيارك: **{user_choice}** | اختياري: **{bot_choice}**\n"
                f"**النتيجة:** {result}{bonus_text}"
            ),
            view=self,
        )

    @discord.ui.button(label="حجر 🪨", style=discord.ButtonStyle.primary)
    async def rock(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.play(interaction, "حجر")

    @discord.ui.button(label="ورقة 📄", style=discord.ButtonStyle.primary)
    async def paper(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.play(interaction, "ورقة")

    @discord.ui.button(label="مقص ✂️", style=discord.ButtonStyle.primary)
    async def scissors(self, interaction: discord.Interaction, button: discord.ui.Button):
        await self.play(interaction, "مقص")


@client.tree.command(name="rps", description="العب حجر ورقة مقص ضد البوت واربح نقاطاً")
async def rps(interaction: discord.Interaction):
    view = RPSView(author_id=interaction.user.id)
    await interaction.response.send_message("اختر حركتك:", view=view)


# --- اللعبة 2: تخمين الرقم (+ نقاط) ---
@client.tree.command(name="guess", description="خمّن رقماً بين 1 و 10 واربح نقاطاً")
@app_commands.describe(number="اكتب رقمك من 1 إلى 10")
async def guess(interaction: discord.Interaction, number: app_commands.Range[int, 1, 10]):
    secret = random.randint(1, 10)
    if number == secret:
        new_total = add_points(interaction.user.id, 5)
        await interaction.response.send_message(
            f"🎯 صحيح! الرقم كان **{secret}**. أحسنت!\n"
            f"⭐ ربحت **+5 نقاط** (رصيدك الآن: **{new_total}**)"
        )
    else:
        await interaction.response.send_message(
            f"❌ خطأ! اخترت **{number}** والرقم الصحيح كان **{secret}**."
        )


